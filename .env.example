# PostgreSQL
POSTGRES_USER=wagering
POSTGRES_PASSWORD=wagering
POSTGRES_DB=wagering
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DB_POOL_MAX=10
DB_LOCK_TIMEOUT_MS=5000

# AWS SQS (LocalStack)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
LOCALSTACK_PORT=4566
SQS_ENDPOINT=http://127.0.0.1:4566
SQS_WAGER_QUEUE_NAME=wager-transactions.fifo
SQS_WAGER_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wagering-events.fifo
SQS_WAIT_TIME_SECONDS=10
SQS_VISIBILITY_TIMEOUT_SECONDS=30

# Workers (cada instância pode ligar/desligar os seus)
WORKER_SQS_CONSUMER=true
WORKER_OUTBOX_PUBLISHER=true
WORKER_PENDING_REFERENCES=true
REFERENCE_MAX_ATTEMPTS=10
REFERENCE_BASE_DELAY_MS=1000

# HTTP
PORT=3000
